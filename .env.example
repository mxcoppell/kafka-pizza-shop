# Kafka Connection Configuration
# Use these settings when connecting Python producers/consumers to Kafka

# Kafka broker connection - for Python clients running in Docker network
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Kafka broker connection - for Python clients running on host machine (macOS)
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9093

# Topic Names
# These match the topics created by init-kafka.sh
TOPIC_PIZZA_ORDERS=pizza-orders
TOPIC_COOKED_PIZZAS=cooked-pizzas
TOPIC_ORDER_EVENTS=order-events

# Consumer Group IDs
CONSUMER_GROUP_PIZZA_MAKERS=pizza-makers
CONSUMER_GROUP_DELIVERY_WORKERS=delivery-workers
CONSUMER_GROUP_BOOKKEEPER=bookkeeper

# Demo Configuration
# Total number of orders to generate in the demo
TOTAL_ORDERS=200

# Order distribution between sources
WEB_ORDERS=120
FRONTDESK_ORDERS=80

# Producer Configuration
# Session timeout for producers/consumers (ms)
SESSION_TIMEOUT_MS=30000
# Request timeout (ms)
REQUEST_TIMEOUT_MS=30000
# Enable auto-commit for consumers
ENABLE_AUTO_COMMIT=true
# Auto-commit interval (ms)
AUTO_COMMIT_INTERVAL_MS=1000

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Demo Timing Configuration (seconds)
# These control the simulation speed (3x faster than original for quicker demo)
COOKING_TIME_MULTIPLIER=0.33
DELIVERY_TIME_MIN=0.33
DELIVERY_TIME_MAX=1.0

# Message Serialization
# Format for messages (json recommended)
MESSAGE_FORMAT=json

# Component Identifiers
PIZZA_MAKER_1_ID=pizza_maker_1
PIZZA_MAKER_2_ID=pizza_maker_2
PIZZA_MAKER_3_ID=pizza_maker_3
DELIVERY_DRIVER_1_ID=delivery_driver_1
DELIVERY_DRIVER_2_ID=delivery_driver_2
FRONTDESK_DELIVERY_ID=frontdesk_delivery

# Additional Kafka Producer Configuration
# Acknowledgment level: 0 (none), 1 (leader), all (all replicas)
PRODUCER_ACKS=1
# Compression type: none, gzip, snappy, lz4, zstd
PRODUCER_COMPRESSION_TYPE=snappy
# Max request size (bytes)
PRODUCER_MAX_REQUEST_SIZE=1048576

# Additional Kafka Consumer Configuration
# Start from beginning or latest offset when no committed offset exists
AUTO_OFFSET_RESET=earliest
# Maximum poll records per poll() call
MAX_POLL_RECORDS=500
# Maximum time between polls before consumer is considered dead (ms)
MAX_POLL_INTERVAL_MS=300000
